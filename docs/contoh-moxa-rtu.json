  "baudrate": 9600,
  "parity": "N",
  "stopbits": 1,
  "bytesize": 8,
  "framer": "rtu",
  "handle_local_echo": false,
  "unit_id": 1,
  "timeout": 1.5,
  "allow_write": false,
  "poll_interval": 5.0,
  "note": "Mode RS-485 2-kawat diatur di MOXA Driver Manager, bukan dari aplikasi ini.",

